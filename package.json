{
  "name": "poludzku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev-vars.mjs && astro dev --port 4321",
    "build": "astro build",
    "preview": "node scripts/dev-vars.mjs && astro preview --port 4321",
    "typecheck": "wrangler types && astro check",
    "test": "node --test --experimental-strip-types \"src/**/*.test.mjs\" \"tests/**/*.test.mjs\"",
    "docs:links": "node scripts/docs-links.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "knip": "knip",
    "spell": "cspell --no-progress .",
    "redirects": "node scripts/redirects.mjs",
    "check": "npm run typecheck && npm run docs:links && npm run build && npm test"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@lucide/astro": "1.44.0",
    "astro": "7.3.8",
    "universal-github-app-jwt": "2.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@cspell/dict-pl_pl": "3.0.8",
    "@playwright/test": "1.65.1",
    "cspell": "10.5.2",
    "knip": "6.48.0",
    "miniflare": "5.20261123.1-beta",
    "pa11y-ci": "4.1.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "wrangler": "4.168.0"
  }
}
