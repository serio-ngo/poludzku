---
import { t } from "../locales/index.ts";
import Glyph from "./Glyph.astro";
import { termsPath } from "../lib/entry.ts";
import type { Lang } from "./view.ts";

interface Props {
    lang: Lang;
    full?: boolean;
}
const { lang, full = false } = Astro.props;
const f = t(lang).footer;
const terms = termsPath(lang);
---

<footer>
    {
        full ? (
            <p>
                <span>{f.publisher}</span>
                <a href={terms}>{f.terms}</a>
                <a href="https://github.com/serio-ngo/poludzku">{f.source}</a>
            </p>
        ) : (
            <a class="gl" href={terms}><Glyph name="scale" lang={lang} /></a>
        )
    }
</footer>

<style>
    footer {
        border-top: var(--border-hairline) solid var(--border-default);
        padding-inline: var(--page-gutter);
    }
    p {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 8px 20px;
        padding: 24px;
        font: var(--type-meta);
        color: var(--text-muted);
    }
    p a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        color: inherit;
        border-bottom: 0;
        text-decoration: underline;
        text-underline-offset: 0.2em;
    }
</style>
