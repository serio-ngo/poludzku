---
import { t } from "../locales/index.ts";
import Glyph from "./Glyph.astro";
import type { Lang } from "./view.ts";

/** Every glyph of the table with its word, once. The avatar entries are plain discs: no request to a live account. */
interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
---

<dl>
    {
        d.legend.map((k) => (
            <div>
                <dt>
                    {k === "viewer" || k === "person" ? (
                        <span class:list={["av", { marker: k === "viewer" }]}>
                            <i />
                        </span>
                    ) : (
                        <Glyph name={k} lang={lang} label="" />
                    )}
                </dt>
                <dd>{d.glyph[k].word}</dd>
            </div>
        ))
    }
</dl>

<style>
    dl {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
        gap: var(--space-2) var(--space-5);
        margin: 0;
    }
    div {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }
    dt {
        display: grid;
        place-items: center;
        width: 36px;
    }
    dd {
        margin: 0;
        font-size: var(--text-body-sm);
        color: var(--text-muted);
    }
    .av {
        display: inline-flex;
        border-radius: 999px;
    }
    .marker {
        background: var(--marker);
        padding: 3px;
    }
    i {
        width: 24px;
        height: 24px;
        border-radius: 50%;
        background: var(--surface-sunken);
        border: 1px solid var(--border-default);
    }
</style>
