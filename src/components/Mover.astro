---
import { t } from "../locales/index.ts";
import Avatar from "./Avatar.astro";
import Glyph from "./Glyph.astro";
import type { Lang, View } from "./view.ts";

/** Who moves: avatar (on the marker for the viewer) + login/word, or a glyph + word. `nobody` forces `nikt` (terminal outcomes). */
interface Props {
    view: View;
    lang: Lang;
    size?: number;
    nobody?: boolean;
}
const { view, lang, size = 24, nobody = false } = Astro.props;
const kind = nobody ? "nobody" : view.mover.kind;
const login = view.mover.login;
const avatar = (kind === "viewer" || kind === "person") && login;
const d = t(lang).mover;
const word = kind === "viewer" ? d.viewer : avatar ? login : kind === "unknown" ? "" : d[kind === "person" ? "someone" : kind];
const glyph = ({ agent: "bot", automation: "cog", nobody: "circle-off", unknown: "circle-help" } as const)[kind as "agent"] ?? "user-round";
---

<span class="mover">
    {avatar ? <Avatar login={login} size={size} marker={kind === "viewer"} /> : <Glyph name={glyph} lang={lang} size={size} label={word ? "" : undefined} />}
    {word && <span>{word}</span>}
</span>

<style>
    .mover {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font: var(--mover-font, var(--weight-medium) 0.9375rem / 1.3 var(--font-ui));
        overflow-wrap: anywhere;
    }
</style>
