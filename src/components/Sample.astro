---
import { derive, present } from "../lib/stages.mjs";
import { issue, approvedSpec, bot } from "../lib/fixtures/stages-cases.mjs";
import { t } from "../locales/index.ts";
import Strip from "./Strip.astro";
import Tiles from "./Tiles.astro";
import type { Lang, View } from "./view.ts";

/** The task screen with invented data: lifecycle stage 4, the agent working. Plain text only, no links. */
interface Props {
    lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const view = present(derive(issue({ spec: approvedSpec, runs: [bot()] }) as Parameters<typeof derive>[0])) as View;
---

<section class="sample">
    <p class="tag">{d.sample}</p>
    <p class="crumb">przyklad/strona › #42</p>
    <p class="title">{d.sampleTitle}</p>
    <Strip view={view} lang={lang} />
    <Tiles view={view} lang={lang} />
</section>

<style>
    .sample {
        display: grid;
        gap: var(--space-4);
        padding: var(--space-5);
        background: var(--surface-card);
        border: 1px solid var(--border-default);
        box-shadow: var(--shadow-stamp-sm);
    }
    .tag {
        justify-self: start;
        padding-inline: var(--space-2);
        background: var(--marker);
        font: var(--weight-semibold) 0.875rem / 1.6 var(--font-mono);
        color: var(--ink-1);
    }
    .crumb {
        font: var(--weight-medium) 0.875rem / 1.4 var(--font-mono);
        color: var(--text-faint);
    }
    .title {
        font: var(--weight-semibold) 1.5rem / 1.3 var(--font-display);
        color: var(--ink-2);
    }
</style>
