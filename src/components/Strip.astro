---
import Check from "@lucide/astro/icons/check";
import { t } from "../locales/index.ts";
import Glyph from "./Glyph.astro";
import { stageName, type Lang, type View } from "./view.ts";

interface Props {
    view: View;
    lang: Lang;
}
const { view, lang } = Astro.props;
const d = t(lang);
const open = view.outcome === "open";
const total = view.stage?.total ?? (view.preset === "generic" ? 5 : view.preset === "lifecycle" ? 7 : 0);
const cur = open ? (view.stage?.index ?? -1) : view.outcome === "done" ? total + 1 : -1;
const unknown = open && !view.stage;
const name = stageName(lang, view.stageNameKey);
const word = open ? name : d.outcome[view.outcome as "done"];
const label = unknown ? d.glyph["circle-help"].word : open ? d.stripLabel(cur, total, name) : word;
const names = view.preset === "lifecycle" || view.preset === "generic" ? (d.stages[view.preset] as Record<number, string>) : null;
const hideWord = open && !unknown && !!names;
---

<div class="strip" style={`--n:${total}`}>
    {
        total > 0 && (
            <ol aria-label={label}>
                {Array.from({ length: total }, (_, k) => {
                    const i = k + 1;
                    const s = i < cur ? "done" : i === cur ? "cur" : "later";
                    return (
                        <li class={s} aria-current={s === "cur" ? "step" : undefined}>
                            <span class="dot">{s === "done" ? <Check size={20} aria-hidden="true" /> : i}</span>
                            {names && <span class="name">{names[i]}</span>}
                        </li>
                    );
                })}
            </ol>
        )
    }
    <p class:list={{ hide: hideWord }}>{unknown ? <Glyph name="circle-help" lang={lang} size={28} /> : word}</p>
</div>

<style>
    ol {
        display: grid;
        grid-template-columns: repeat(var(--n), minmax(0, 1fr));
        list-style: none;
        margin: 0;
        padding: 0;
    }
    li {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    li + li::before {
        content: "";
        position: absolute;
        top: 19px;
        left: -50%;
        width: 100%;
        height: 2px;
        background: var(--line-1);
    }
    li + li.done::before,
    li + li.cur::before {
        background: var(--ink-1);
    }
    .dot {
        position: relative;
        z-index: 1;
        display: grid;
        place-items: center;
        width: 40px;
        height: 40px;
        box-sizing: border-box;
        border-radius: 50%;
        background: var(--surface-page);
        border: 2px solid var(--line-1);
        font: var(--weight-semibold) 0.9375rem / 1 var(--font-mono);
        color: var(--text-muted);
    }
    .done .dot {
        background: var(--ink-1);
        border-color: var(--ink-1);
        color: var(--paper-0);
    }
    .cur .dot {
        background: var(--marker);
        border: var(--border-thick) solid var(--ink-1);
        box-shadow: var(--shadow-stamp);
        font-weight: var(--weight-semibold);
        color: var(--ink-1);
    }
    .name {
        max-width: 120px;
        margin-top: 12px;
        font: var(--weight-medium) 0.8125rem / 1.3 var(--font-ui);
        text-align: center;
        color: var(--text-muted);
        overflow-wrap: anywhere;
    }
    .cur .name {
        font-weight: var(--weight-bold, 700);
        color: var(--ink-1);
    }
    p {
        margin-top: var(--space-4);
        font: var(--weight-semibold) 1.75rem / 1.2 var(--font-display);
        color: var(--ink-1);
    }
    @media (max-width: 639px) {
        .name {
            display: none;
        }
    }
    @media (min-width: 640px) {
        .hide {
            display: none;
        }
    }
</style>
