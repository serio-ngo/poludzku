---
import Glyph from "./Glyph.astro";
import Mover from "./Mover.astro";
import { t } from "../locales/index.ts";
import { stageName, tone, type Lang, type View } from "./view.ts";

interface Props {
    view: View;
    lang: Lang;
}
const { view, lang } = Astro.props;
const open = view.outcome === "open";
const d = t(lang);
---

<div class="tiles">
    <div class="cell">
        <span class="pl-label">{d.cells.mover}</span>
        <div class="value">
            {view.mover.kind === "viewer" && open ? <mark class="pl-mark">{d.cells.yours}</mark> : <Mover view={view} lang={lang} size={28} nobody={!open} />}
        </div>
    </div>
    {
        open && (
            <>
                <div class="cell">
                    <span class="pl-label">{d.cells.checks}</span>
                    <div class="value" style={tone(view.healthGlyph)}>
                        <Glyph name={view.healthGlyph as "circle"} lang={lang} size={28} label="" />
                        <span>{d.glyph[view.healthGlyph as "circle"].word}</span>
                    </div>
                </div>
                <div class="cell">
                    <span class="pl-label">{d.cells.next}</span>
                    <div class="value">
                        {view.next ? (
                            <>
                                <Glyph name="arrow-right" lang={lang} size={28} label="" />
                                <span>{stageName(lang, view.nextNameKey)}</span>
                            </>
                        ) : (
                            <Glyph name="circle-help" lang={lang} size={28} />
                        )}
                    </div>
                </div>
            </>
        )
    }
</div>

<style>
    .tiles {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        border-top: var(--rule);
        border-bottom: var(--hairline);
        --mover-font: var(--weight-semibold) 1.75rem / 1.2 var(--font-display);
    }
    .cell {
        min-width: 0;
        padding: 24px 0;
    }
    .cell + .cell {
        padding-left: 32px;
        border-left: var(--hairline);
    }
    .value {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin-top: var(--space-3);
        font: var(--mover-font);
        color: var(--ink-1);
        overflow-wrap: anywhere;
    }
    @media (max-width: 639px) {
        .tiles {
            grid-template-columns: minmax(0, 1fr);
        }
        .cell + .cell {
            padding-left: 0;
            border-left: 0;
            border-top: var(--hairline);
        }
    }
</style>
