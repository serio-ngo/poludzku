---
import { t } from "../locales/index.ts";
import Glyph from "./Glyph.astro";
import type { Lang } from "./view.ts";

interface Props {
    lang: Lang;
    path: string;
    signedIn: boolean;
    login?: string;
}
const { lang, path, signedIn, login } = Astro.props;
const home = lang === "en" ? "/en" : "/";
const other = lang === "en" ? path.replace(/^\/en(?=\/|$)/, "") || "/" : path === "/" ? "/en" : `/en${path}`;
---

<header>
    <a class="pl-wm" href={home} style="--wm-size:24px" aria-label="po ludzku"><span class="pl-wm__name">po<span class="pl-wm__mark">ludzku</span></span></a>
    <nav>
        <a class="gl lang" href={other} hreflang={lang === "en" ? "pl" : "en"}>{t(lang).nav.lang}</a>
        {
            signedIn ? (
                <>
                    {login && <span class="login">{login}</span>}
                    <form method="post" action="/sign-out">
                        <button class="gl" type="submit"><Glyph name="log-out" lang={lang} /></button>
                    </form>
                </>
            ) : (
                <a class="signin" href={`/sign-in?next=${encodeURIComponent(path)}`}>
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                        <path d="M9 18c-4.51 2-5-2-7-2" />
                    </svg>
                    {t(lang).glyph["log-in"].word}
                </a>
            )
        }
    </nav>
</header>

<style>
    header {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-2) var(--space-4);
        min-height: var(--topbar-height);
        padding-inline: var(--page-gutter);
        border-bottom: 1px solid var(--border-default);
        background: var(--surface-page);
        position: sticky;
        top: 0;
        z-index: 10;
    }
    .pl-wm {
        min-height: 44px;
    }
    .pl-wm__name {
        font-family: var(--font-ui);
        font-weight: var(--weight-extrabold);
    }
    .pl-wm__mark {
        position: relative;
        z-index: 0;
        margin-left: 0.04em;
        color: var(--ink-1);
    }
    .pl-wm__mark::before {
        content: "";
        position: absolute;
        z-index: -1;
        inset-inline: 0 -0.08em;
        bottom: 0.086em;
        height: 0.74em;
        border-radius: 0.05em;
        background: var(--marker);
    }
    nav {
        display: flex;
        align-items: center;
        gap: var(--space-3);
    }
    .signin {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        min-height: 44px;
        padding: 0 14px;
        border: var(--border-mid) solid var(--ink-1);
        border-radius: var(--radius-1);
        font: var(--weight-semibold) 15px / 1 var(--font-ui);
        color: var(--ink-1);
        background: var(--surface-card);
        text-decoration: none;
    }
    .signin:hover {
        background: var(--surface-sunken);
    }
    .login {
        font: var(--weight-medium) 0.875rem / 1 var(--font-mono);
        color: var(--text-muted);
    }
    .lang {
        font: var(--weight-medium) 0.875rem / 1 var(--font-mono);
        color: var(--text-muted);
    }
</style>
