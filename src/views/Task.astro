---
import Details from "../components/Details.astro";
import Glyph from "../components/Glyph.astro";
import Strip from "../components/Strip.astro";
import Tiles from "../components/Tiles.astro";
import { clock } from "../lib/format.ts";
import { t } from "../locales/index.ts";
import type { Lang } from "../components/view.ts";

interface Props {
    lang: Lang;
    owner: string;
    repo: string;
    ev: { number: number; title: string; url: string };
    view: any;
    task: any;
    readAt: string;
}
const { lang, owner, repo, ev, view, task, readAt } = Astro.props;
const base = `${lang === "en" ? "/en" : ""}/gh/${owner}/${repo}`;
const time = clock(readAt);
---

<nav class="crumb wide">
    <a href={base}>← {owner}/{repo}</a>
</nav>
<div class="head wide">
    <h1>{ev.title} <span class="num">#{ev.number}</span></h1>
    <span class="acts">
        <time datetime={readAt} class="sr-only">{time}</time>
        <a class="gl" href={`${base}/${ev.number}`} title={t(lang).readAt(time)}><Glyph name="refresh-cw" lang={lang} /></a>
        <a class="gl" href={ev.url}><Glyph name="external-link" lang={lang} /></a>
    </span>
</div>
<div class="wide"><Strip view={view} lang={lang} /></div>
<div class="wide"><Tiles view={view} lang={lang} /></div>
<Details view={view} lang={lang} task={task} />

<style>
    :global(.task) > .wide {
        max-width: 1040px;
        margin-top: 3.5rem;
    }
    :global(.task) > .crumb {
        margin-top: 0;
        font: var(--weight-medium) 0.8125rem / 1.4 var(--font-mono);
        color: var(--text-muted);
    }
    .crumb a {
        color: inherit;
        text-decoration: none;
    }
    .head {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-3);
    }
    :global(.task) > .head {
        margin-top: var(--space-4);
    }
    h1 {
        flex: 1 1 0;
        min-width: 0;
        font: var(--weight-semibold) 2.5rem / 1.1 var(--font-display);
        letter-spacing: -0.02em;
        color: var(--text-strong);
        overflow-wrap: anywhere;
    }
    .num {
        font: var(--weight-medium) 1.25rem / 1 var(--font-mono);
        letter-spacing: 0;
        color: var(--text-muted);
    }
    .acts {
        display: inline-flex;
    }
</style>
