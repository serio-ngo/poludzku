---
import Details from "../components/Details.astro";
import Glyph from "../components/Glyph.astro";
import Strip from "../components/Strip.astro";
import Tiles from "../components/Tiles.astro";
import { clock } from "../lib/format.ts";
import { t } from "../locales/index.ts";
import type { Lang } from "../components/view.ts";

interface Props {
    lang: Lang;
    owner: string;
    repo: string;
    ev: { number: number; title: string; url: string };
    view: any;
    task: any;
    readAt: string;
}
const { lang, owner, repo, ev, view, task, readAt } = Astro.props;
const base = `${lang === "en" ? "/en" : ""}/gh/${owner}/${repo}`;
const time = clock(readAt);
---

<nav class="crumb">
    <a href={base}>{owner}/{repo}</a> › #{ev.number}
</nav>
<h1>{ev.title}</h1>
<div class="gap"><Strip view={view} lang={lang} size="lg" /></div>
<div class="gap"><Tiles view={view} lang={lang} /></div>
<p class="bar">
    <a class="gl" href={ev.url}><Glyph name="external-link" lang={lang} /></a>
    <span class="read">
        <time datetime={readAt} title={t(lang).readAt(time)}>{time}</time>
        <a class="gl" href={`${base}/${ev.number}`}><Glyph name="refresh-cw" lang={lang} /></a>
    </span>
</p>
<Details view={view} lang={lang} task={task} />

<style>
    .crumb {
        font: var(--weight-medium) 0.875rem / 1.4 var(--font-mono);
        color: var(--text-muted);
    }
    h1 {
        margin-top: 10px;
        font: var(--weight-semibold) 1.5rem / 1.3 var(--font-display);
        color: var(--text-strong);
        overflow-wrap: anywhere;
    }
    .gap {
        margin-top: var(--space-7, 3rem);
    }
    .bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-block: var(--space-6);
    }
    .read {
        display: inline-flex;
        align-items: center;
        font: 0.8125rem / 1 var(--font-mono);
        color: var(--text-faint);
    }
</style>
