{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "editorial", "node_modules"],
  "compilerOptions": {
    "types": ["astro/client"],
    "verbatimModuleSyntax": false,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true
  }
}
