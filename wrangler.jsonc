  "ratelimits": [{ "name": "RL_GAME", "namespace_id": "2095", "simple": { "limit": 30, "period": 60 } }],
  "assets": { "html_handling": "drop-trailing-slash" },
  "previews": {
    "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionDO" }] },
