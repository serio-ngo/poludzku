{
  "name": "poludzku",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionDO" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionDO"] }],
  "vars": { "SITE_ORIGIN": "https://poludzku.info" },
  "assets": { "html_handling": "drop-trailing-slash" },
  "previews": { "durable_objects": { "bindings": [{ "name": "SESSIONS", "class_name": "SessionDO" }] } },
}
